# Copy OUTSIDE the checkout to /etc/gym-uat/backend.env; restrict access to the operator.
# Empty secrets intentionally fail validation. No default credentials.
NODE_ENV=production
DEPLOYMENT_ENV=uat
PORT=3000
FRONTEND_ORIGIN=https://uat.example.invalid
TRUST_PROXY_HOPS=1
UAT_DATA_CLASSIFICATION=DEMO_ONLY
MONGODB_URI=
MONGODB_DB=gym_uat_demo
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
JWT_ISSUER=gym-api
JWT_AUDIENCE=gym-web
RETAIL_QUOTE_SECRET=
PICKUP_LOCATION=DEMO ONLY - quầy nghiệm thu
# TRANSFER intentionally disabled. CASH fixtures represent simulated money only.
RECEIVING_ACCOUNTS=[]
RECEIVING_ACCOUNT_DETAILS=[]
PAYOUT_ACCOUNTS=[]
RESET_OTP_PEPPER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REMINDER_TICK_MS=60000
REMINDER_BATCH_SIZE=50
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
# One-off operator override: UAT_DEMO_SEED=ALLOW_DEMO_ONLY; leave disabled for the running service.
UAT_DEMO_SEED=
DEMO_STAFF_PHONE=
DEMO_STAFF_PASSWORD=
DEMO_TRAINER_PHONE=
DEMO_TRAINER_PASSWORD=
DEMO_MEMBER_PHONE=
DEMO_MEMBER_PASSWORD=
