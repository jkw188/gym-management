NODE_ENV=test
# Optional. Leave blank to start a disposable MongoDB 8.0.17 replica set.
# For an existing TEST-ONLY replica set, use an explicit gym_test_ database (maximum 24 characters).
# MONGODB_TEST_URI=mongodb://127.0.0.1:27018/gym_test_s01?replicaSet=rsTest
MONGODB_TEST_URI=
# Optional binary cache; use an installed matching mongod when downloads are unavailable.
# MONGOMS_DOWNLOAD_DIR=../.cache/mongodb-binaries
# MONGOMS_SYSTEM_BINARY=C:/MongoDB/bin/mongod.exe
