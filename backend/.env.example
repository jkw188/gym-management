NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Local development only. Put credentials only in your ignored .env.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=gym_management

# Required by US-02. Generate at least 32 random bytes; never commit the real secret.
# PowerShell: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
JWT_ISSUER=gym-api
JWT_AUDIENCE=gym-web

# US-05 quên mật khẩu: để trống thì tắt chức năng (API trả 503). Tạo như JWT_ACCESS_SECRET nhưng PHẢI là giá trị khác.
# Cần MongoDB chạy dạng replica set vì US-05 dùng transaction.
RESET_OTP_PEPPER=
# Bắt buộc khi đã đặt RESET_OTP_PEPPER. Dev/test dùng hộp thư SMTP sandbox của nhóm, không dùng tài khoản thư thật.
# SMTP_SECURE=true cho cổng 465 (TLS ngay từ đầu), false cho cổng 587 hoặc sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Required only by npm run seed:admin. No default password.
SEED_ADMIN_PHONE=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
